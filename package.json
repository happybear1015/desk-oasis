{
  "name": "desk-oasis",
  "version": "1.4.10",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server.mjs",
    "server": "node server.mjs --port=8787",
    "dev:full": "node dev.mjs",
    "desktop:dev": "node desktop/dev.mjs",
    "desktop:build": "vite build && electron-builder --win",
    "desktop:build:mac": "vite build && electron-builder --mac",
    "mac:cloud": "node scripts/mac-cloud-push.mjs",
    "desktop:release": "node scripts/publish-release.mjs",
    "ios:sync": "vite build && node scripts/prepare-ios-web.mjs",
    "ios:cloud": "node scripts/ios-cloud-push.mjs",
    "ios:asc": "node scripts/ios-setup-asc.mjs",
    "ios:icp": "node scripts/ios-icp-info.mjs"
  },
  "build": {
    "appId": "com.deskoasis.app",
    "productName": "DeskOasis",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "shared/**/*",
      "public/icons/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icons/icon-512.png"
    },
    "mac": {
      "category": "public.app-category.lifestyle",
      "icon": "public/icons/icon-512.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "桌面生态 DeskOasis",
      "artifactName": "DeskOasis-${version}-${arch}.dmg"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "桌面生态"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "happybear1015",
        "repo": "desk-oasis"
      }
    ]
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "three": "^0.180.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "vite": "^7.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "description": "无边框透明 3D 写实桌面鱼缸 + 手机一键悬浮窗伴侣",
  "author": "happybear1015",
  "repository": {
    "type": "git",
    "url": "https://github.com/happybear1015/desk-oasis.git"
  }
}
